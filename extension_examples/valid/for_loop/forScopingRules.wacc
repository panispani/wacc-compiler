# Counts from 1 to 10 and then prints the original value of i

begin

int i = 1;
int x = 1;

for int i = 0; i < 10; i = i + 1 do
    # i here is the loop variable
    # other variables from parent scope such as x can be accessed as expected
    println i + x
done;

# i from the parent scope (should print 1)
println i

end